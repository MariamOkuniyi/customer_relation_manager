
<%# ========================================= %>
<%# ALL CUSTOMERS PAGE                       %>
<%# Displays every customer in the database  %>
<%# ========================================= %>

<h1>All Customers</h1>

<%# Navigation links to the other customer pages. %>
<nav class="customer-navigation">
  <%= link_to "All Customers", root_path %>
  <%= link_to "Alphabetized Customers", customers_alphabetized_path %>
  <%= link_to "Missing Email", customers_missing_email_path %>
</nav>

<%# Display all customers using the reusable partial. %>
<div class="customers-container">

  <% if @customers.any? %>

    <%# Render the _customer.html.erb partial for each customer. %>
    <%= render partial: "customer", collection: @customers %>

  <% else %>

    <p>No customers found.</p>

  <% end %>

</div>
